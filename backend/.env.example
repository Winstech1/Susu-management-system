# Rename this file to .env and fill in your real values

PORT=5000

# PostgreSQL connection (Render/Neon/local)
DATABASE_URL=postgresql://username:password@localhost:5432/susu_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
